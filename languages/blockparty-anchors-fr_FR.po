#. Plugin Name of the plugin
#: blockparty-anchors.php
msgid "Blockparty Anchors"
msgstr "Blockparty Ancres"

#. Description of the plugin
#: blockparty-anchors.php
msgid ""
"Adds two new blocks to the WordPress editor: an anchor block to create an "
"anchor system on your pages, and an anchor list block to list those anchors."
msgstr ""
"Ajoute deux nouveaux blocs à l'éditeur WordPress : un bloc d'ancrage pour "
"créer un système d'ancres sur vos pages, et un bloc de liste d'ancres pour "
"lister ces ancres."

#. Author of the plugin
#: blockparty-anchors.php
msgid "Be API Technical Team"
msgstr "L’équipe technique de Be API"

#. Author URI of the plugin
#: blockparty-anchors.php
msgid "https://beapi.fr"
msgstr "https://beapi.fr"

#: views/anchors-list.php:20 build/anchors-list/index.js:1
msgid "Quick access"
msgstr "Accès rapide"

#: build/anchor/index.js:1
msgid "Settings"
msgstr "Réglages"

#: build/anchor/index.js:1
msgid "Anchor ID"
msgstr "Identifiant de l’ancre"

#: build/anchor/index.js:1
msgid ""
"This identifier is generated automatically when the anchor is edited the "
"first time. It should be edited with cautions afterwards."
msgstr ""
"Cet identifiant est généré automatiquement lors de la première modification "
"de l'ancre. Toute modification ultérieure doit être effectuée avec "
"précaution."

#: build/anchor/index.js:1
msgid "Anchor label"
msgstr "Libellé de l’ancre"

#: build/anchors-list/index.js:1
msgid "Enter anchor title"
msgstr "Saisissez le libellé de l’ancre"

#: build/anchors-list/index.js:1
msgid "Anchor title"
msgstr "Titre de l’ancre"

#: build/anchors-list/index.js:1
msgid ""
"No anchors found on this page. Add an Anchor block to populate this list."
msgstr ""
"No anchors found on this page. Add an Anchor block to populate this list."

#: build/anchor/block.json
msgctxt "block title"
msgid "Anchor"
msgstr "Ancre"

#: build/anchor/block.json
msgctxt "block description"
msgid ""
"Place an anchor on your page. It will be listed in the anchor list block."
msgstr ""
"Placez une ancre sur votre page. Elle apparaîtra dans le bloc de liste des "
"ancres."

#: build/anchors-list/block.json
msgctxt "block title"
msgid "Anchors List"
msgstr "Liste des ancres"

#: build/anchors-list/block.json
msgctxt "block description"
msgid "Displays the list of anchors placed on your page."
msgstr "Affiche la liste des ancres placées sur votre page."
